PROJECT_NAME           = "guess-number"
PROJECT_NUMBER         = "@PACKAGE_VERSION@"
PROJECT_BRIEF          = "Guess a number in decimal or Roman notation"
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = English
OPTIMIZE_OUTPUT_FOR_C  = YES
INPUT                  = "@srcdir@/guess-number.c" "@srcdir@/roman.c" "@srcdir@/roman.h" mainpage.dox
FILE_PATTERNS          = *.c *.h *.dox
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
SOURCE_BROWSER         = YES
FULL_PATH_NAMES        = NO
GENERATE_HTML          = YES
TIMESTAMP              = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = YES
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg
DOT_NUM_THREADS        = 1
DOT_FONTNAME           = FreeSans

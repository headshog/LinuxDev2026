"Language-Team: Russian\n"
"Language: ru\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "Yes"
msgstr "Да"

msgid "No"
msgstr "Нет"

#, c-format
msgid "Usage: %s [OPTION...]\n"
msgstr "Использование: %s [ПАРАМЕТР...]\n"

#, c-format
msgid "The computer guesses an integer from %d to %d using binary search.\n\n"
msgstr "Компьютер угадывает целое число от %d до %d методом половинного деления.\n\n"

msgid ""
"Options:\n"
"  -r, --roman      Display numbers as Roman numerals (I..MMMCMXCIX).\n"
"  -h, --help       Show this help and exit.\n"
"  -V, --version    Show version and exit.\n"
"      --help-md    Output English help as a Doxygen main page.\n"
msgstr ""
"Параметры:\n"
"  -r, --roman      Показывать числа римскими цифрами (I..MMMCMXCIX).\n"
"  -h, --help       Показать эту справку и завершить работу.\n"
"  -V, --version    Показать версию и завершить работу.\n"
"      --help-md    Вывести английскую справку как титульную страницу Doxygen.\n"

#, c-format
msgid "Answer exactly \"%s\" or \"%s\". Other answers repeat the question.\n"
msgstr "Отвечайте в точности \"%s\" или \"%s\". При другом ответе вопрос повторяется.\n"

msgid "Closing standard input is an error. At most 12 questions are needed."
msgstr "Закрытие стандартного ввода — ошибка. Требуется не более 12 вопросов."

#, c-format
msgid "Think of an integer between %s and %s.\n"
msgstr "Загадайте целое число от %s до %s.\n"

#, c-format
msgid "Is your number greater than %s? (%s/%s): "
msgstr "Ваше число больше %s? (%s/%s): "

msgid "Error: standard input was closed.\n"
msgstr "Ошибка: стандартный ввод закрыт.\n"

#, c-format
msgid "Error reading input: %s\n"
msgstr "Ошибка чтения ввода: %s\n"

#, c-format
msgid "Please answer exactly \"%s\" or \"%s\".\n"
msgstr "Введите в точности \"%s\" или \"%s\".\n"

#, c-format
msgid "Your number is %s.\n"
msgstr "Ваше число: %s.\n"

#, c-format
msgid "Unknown or incomplete option: %s\n"
msgstr "Неизвестный или неполный параметр: %s\n"

msgid "Positional arguments are not supported.\n"
msgstr "Позиционные аргументы не поддерживаются.\n"

#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Для получения справки выполните '%s --help'.\n"
